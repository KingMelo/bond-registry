{
  "name": "bond-registry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build apps/holder --config vite.config.js --outDir ../../dist/holder --emptyOutDir && vite build apps/issuer --config vite.config.js --outDir ../../dist/issuer --emptyOutDir",
    "start": "node server/index.js",
    "dev:holder": "APP=holder node server/index.js",
    "dev:issuer": "APP=issuer node server/index.js"
  },
  "dependencies": {
    "express": "4.21.2",
    "pg": "8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.10",
    "vite": "5.4.11"
  }
}
