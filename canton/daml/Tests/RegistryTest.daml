-- The design's rules, checked on Canton's own engine: paper, units, control and privacy.
module Tests.RegistryTest where

import Daml.Script
import DA.Assert
import DA.Time (days, addRelTime)
import DA.Date (toDateUTC)
import qualified DA.Text as T
import Registry

h : Text -> Text   -- a stand-in SHA-256 for a named document
h name = "0x" <> T.implode (replicate (64 - T.length tag) "0") <> tag
  where tag = T.implode (take 8 (filter (`elem` T.explode "0123456789abcdef") (T.explode (T.asciiToLower name)))) <> "a1"

longReason : Text
longReason = "The amount on the instrument I received does not match what the register shows, and I did not agree to take this " <>
  "portion from the assignor. I have not signed anything about it and would like the issuer to review how this assignment was created. Please return it."

data Cast = Cast with issuer, platform, alice, bob, trustee, outsider : Party

setup : Script (Cast, ContractId Bond)
setup = do
  issuer <- allocateParty "Penson Trust"
  platform <- allocateParty "Platform"
  alice <- allocateParty "Company A"
  bob <- allocateParty "Company D"
  trustee <- allocateParty "Trustee"
  outsider <- allocateParty "Outsider"
  bond <- submitMulti [issuer, platform] [] $ createCmd Bond with
    issuer; platform; bondId = "PENS-0001-BD"; total = 10_000_000_000; unassigned = 10_000_000_000; redeemed = 0; prior = 0
    instrumentHash = h "bond"; ucc1Hash = h "ucc1"; observers = [trustee]; issuerName = "Penson Trust"
  let cast = Cast with issuer; platform; alice; bob; trustee; outsider
  pure (cast, bond)

-- Issue A00001 to someone not on Canton yet, mail it, then they claim it, record nothing else, and accept.
issueAndAccept : Cast -> ContractId Bond -> Script (ContractId Bond, ContractId Assignment)
issueAndAccept c bond = do
  (bond, offer) <- submit c.issuer $ exerciseCmd bond Issue with
    recordId = "PENS-0001-BD-A00001"; units = 1_000_000; docHash = h "a00001"; ucc3Hash = Some (h "ucc3a"); assigneeName = "Company A"; assignee = None
  now <- getTime
  offer <- submit c.issuer $ exerciseCmd offer RecordMailing with sentOn = now; mailingRef = h "mail"
  -- After the transfer code and their key, the platform names their party on the offer.
  offer <- submit c.platform $ exerciseCmd offer Bind with party = c.alice
  a1 <- submit c.alice $ exerciseCmd offer Accept
  pure (bond, a1)

test_paper_and_units = script do
  (c, bond) <- setup
  -- No paper, no record.
  submitMustFail c.issuer $ exerciseCmd bond Issue with
    recordId = "PENS-0001-BD-A00002"; units = 1; docHash = "not a hash"; ucc3Hash = None; assigneeName = "X"; assignee = None
  -- Never more than is left to assign.
  submitMustFail c.issuer $ exerciseCmd bond Issue with
    recordId = "PENS-0001-BD-A00002"; units = 10_000_000_001; docHash = h "big"; ucc3Hash = None; assigneeName = "X"; assignee = None
  -- Only the issuer issues.
  submitMustFail c.platform $ exerciseCmd bond Issue with
    recordId = "PENS-0001-BD-A00002"; units = 1; docHash = h "x"; ucc3Hash = None; assigneeName = "X"; assignee = None
  (bond, a1) <- issueAndAccept c bond
  Some b <- queryContractId c.issuer bond
  b.unassigned === 10_000_000_000 - 1_000_000
  Some a <- queryContractId c.alice a1
  a.recordId === "PENS-0001-BD-A00001"
  a.instrumentHash === h "a00001"
  pure ()

test_control = script do
  (c, bond) <- setup
  (bond, a1) <- issueAndAccept c bond
  -- Nobody else acts on Company A's assignment: not the issuer, not the platform.
  submitMustFail c.issuer $ exerciseCmd a1 AssignOut with
    childId = "PENS-0001-BD-A00001-1"; childUnits = 1; childHash = h "x"; childName = "X"; childParty = None
  submitMustFail c.platform $ exerciseCmd a1 AssignOut with
    childId = "PENS-0001-BD-A00001-1"; childUnits = 1; childHash = h "x"; childName = "X"; childParty = None
  -- The issuer can't archive it either: archiving needs every signatory, Company A included.
  submitMustFail c.issuer $ archiveCmd a1
  pure ()

test_partial_assignment = script do
  (c, bond) <- setup
  (bond, a1) <- issueAndAccept c bond
  -- An assign-out needs its own signed paper, and the one-dash number.
  submitMustFail c.alice $ exerciseCmd a1 AssignOut with
    childId = "PENS-0001-BD-A00001-1"; childUnits = 1040; childHash = "none"; childName = "Company D"; childParty = None
  submitMustFail c.alice $ exerciseCmd a1 AssignOut with
    childId = "PENS-0001-BD-A00001-1-1"; childUnits = 1040; childHash = h "d1"; childName = "Company D"; childParty = None
  submitMustFail c.alice $ exerciseCmd a1 AssignOut with
    childId = "PENS-0001-BD-A00001-1"; childUnits = 1_000_001; childHash = h "d1"; childName = "Company D"; childParty = None
  (rest, offer) <- submit c.alice $ exerciseCmd a1 AssignOut with
    childId = "PENS-0001-BD-A00001-1"; childUnits = 1040; childHash = h "d1"; childName = "Company D"; childParty = None
  Some ov <- queryContractId c.alice offer
  (ov.issuerName, ov.assignorName, ov.assigneeName) === ("Penson Trust", "Company A", "Company D")  -- all three, by name
  -- The remainder keeps its original paper and lists the carve-out: original minus carve-outs = held.
  Some r <- queryContractId c.alice rest
  r.units === 1_000_000 - 1040
  r.instrumentHash === h "a00001"
  r.carveOuts === [h "d1"]
  Some o <- queryContractId c.alice offer
  o.instrumentHash === h "d1"
  o.parentId === Some "PENS-0001-BD-A00001"
  -- The assignor records the assign-out's UCC-3 and mailing; then Company D claims it and accepts.
  offer <- submit c.alice $ exerciseCmd offer RecordUcc3 with filedHash = h "ucc3d"
  offer <- submit c.platform $ exerciseCmd offer Bind with party = c.bob
  d1 <- submit c.bob $ exerciseCmd offer Accept
  -- Each holder controls only their own portion.
  submitMustFail c.alice $ exerciseCmd d1 AssignOut with
    childId = "PENS-0001-BD-A00001-2"; childUnits = 1; childHash = h "x"; childName = "X"; childParty = None
  submitMustFail c.bob $ exerciseCmd rest AssignOut with
    childId = "PENS-0001-BD-A00001-2"; childUnits = 1; childHash = h "x"; childName = "X"; childParty = None
  -- It repeats under the same root, one dash: A00001-2 from Company D's portion.
  (_, o2) <- submit c.bob $ exerciseCmd d1 AssignOut with
    childId = "PENS-0001-BD-A00001-2"; childUnits = 40; childHash = h "d2"; childName = "Company E"; childParty = None
  Some o2v <- queryContractId c.bob o2
  o2v.parentId === Some "PENS-0001-BD-A00001-1"
  pure ()

test_reject_returns_units = script do
  (c, bond) <- setup
  (bond, a1) <- issueAndAccept c bond
  (rest, offer) <- submit c.alice $ exerciseCmd a1 AssignOut with
    childId = "PENS-0001-BD-A00001-1"; childUnits = 1040; childHash = h "d1"; childName = "Company D"; childParty = Some c.bob
  submitMustFail c.bob $ exerciseCmd offer Reject with reason = "Not the amount we agreed."
  submitMustFail c.alice $ exerciseCmd offer Reject with reason = longReason   -- only the assignee rejects
  back <- submit c.bob $ exerciseCmd offer Reject with reason = longReason
  -- Company D never saw Company A's assignment; Company A reclaims the units from the returned record.
  rest <- submit c.alice $ exerciseCmd rest ReclaimToAssignment with returnedCid = back
  Some r <- queryContractId c.alice rest
  r.units === 1_000_000
  -- An issuer-made offer that's rejected goes back to the bond.
  (bond, o) <- submit c.issuer $ exerciseCmd bond Issue with
    recordId = "PENS-0001-BD-A00002"; units = 500; docHash = h "a2"; ucc3Hash = None; assigneeName = "Company D"; assignee = Some c.bob
  back <- submit c.bob $ exerciseCmd o Reject with reason = longReason
  bond <- submit c.issuer $ exerciseCmd bond ReclaimToBond with returnedCid = back
  Some b <- queryContractId c.issuer bond
  b.unassigned === 10_000_000_000 - 1_000_000
  pure ()

test_privacy = script do
  (c, bond) <- setup
  (bond, a1) <- issueAndAccept c bond
  (rest, offer) <- submit c.alice $ exerciseCmd a1 AssignOut with
    childId = "PENS-0001-BD-A00001-1"; childUnits = 1040; childHash = h "d1"; childName = "Company D"; childParty = Some c.bob
  d1 <- submit c.bob $ exerciseCmd offer Accept
  -- Company D sees its own assignment, not Company A's remainder.
  mineD <- query @Assignment c.bob
  map (\(_, a) -> a.recordId) mineD === ["PENS-0001-BD-A00001-1"]
  -- Company A sees its remainder and, as assignor, the portion it assigned.
  mineA <- query @Assignment c.alice
  length mineA === 2
  -- The issuer sees both; the trustee named on the bond sees both, read-only.
  length <$> query @Assignment c.issuer >>= (=== 2)
  length <$> query @Assignment c.trustee >>= (=== 2)
  submitMustFail c.trustee $ exerciseCmd d1 AssignOut with
    childId = "PENS-0001-BD-A00001-2"; childUnits = 1; childHash = h "x"; childName = "X"; childParty = None
  -- Anyone else sees nothing at all.
  length <$> query @Assignment c.outsider >>= (=== 0)
  length <$> query @Bond c.outsider >>= (=== 0)
  pure ()

test_no_response = script do
  (c, bond) <- setup
  (bond, offer) <- submit c.issuer $ exerciseCmd bond Issue with
    recordId = "PENS-0001-BD-A00003"; units = 700; docHash = h "a3"; ucc3Hash = None; assigneeName = "Company D"; assignee = None
  submitMustFail c.platform $ exerciseCmd offer RecordNoResponse   -- not mailed yet
  now <- getTime
  offer <- submit c.issuer $ exerciseCmd offer RecordMailing with sentOn = now; mailingRef = h "mail"
  passTime (days 29)
  submitMustFail c.platform $ exerciseCmd offer RecordNoResponse   -- not a day sooner
  passTime (days 2)
  submitMustFail c.issuer $ exerciseCmd offer RecordNoResponse     -- the platform records it, nobody else
  offer <- submit c.platform $ exerciseCmd offer RecordNoResponse
  submitMustFail c.platform $ exerciseCmd offer RecordNoResponse   -- once
  -- It records a fact and decides nothing: it's still an offer, and the assignee can still answer either way.
  Some o <- queryContractId c.issuer offer
  assertMsg "the date is recorded" (o.noResponseAsOf /= None)
  length <$> query @Assignment c.issuer >>= (=== 0)
  offer <- submit c.platform $ exerciseCmd offer Bind with party = c.bob
  _ <- submit c.bob $ exerciseCmd offer Reject with reason = longReason
  pure ()

test_redemption = script do
  (c, bond) <- setup
  (bond, a1) <- issueAndAccept c bond
  submitMustFail c.issuer $ exerciseCmd a1 Redeem with paymentHash = "none"; bondCid = bond
  submit c.issuer $ exerciseCmd a1 Redeem with paymentHash = h "paid"; bondCid = bond
  [(_, b)] <- query @Bond c.issuer
  b.redeemed === 1_000_000
  length <$> query @Assignment c.alice >>= (=== 0)
  pure ()

test_issue_numbering = script do
  (c, bond) <- setup
  -- The register numbers assignments; Canton checks the form: <bond>-A plus five digits.
  submitMustFail c.issuer $ exerciseCmd bond Issue with
    recordId = "PENS-0001-BD-A1"; units = 1; docHash = h "x"; ucc3Hash = None; assigneeName = "X"; assignee = None
  submitMustFail c.issuer $ exerciseCmd bond Issue with
    recordId = "OTHER-0001-BD-A00001"; units = 1; docHash = h "x"; ucc3Hash = None; assigneeName = "X"; assignee = None
  _ <- submit c.issuer $ exerciseCmd bond Issue with
    recordId = "PENS-0001-BD-A00007"; units = 1; docHash = h "x"; ucc3Hash = None; assigneeName = "X"; assignee = None
  pure ()

test_mailing_receipt_ucc3 = script do
  (c, bond) <- setup
  (bond, offer) <- submit c.issuer $ exerciseCmd bond Issue with
    recordId = "PENS-0001-BD-A00001"; units = 1_000; docHash = h "a1"; ucc3Hash = None; assigneeName = "Company A"; assignee = Some c.alice
  now <- getTime
  -- The mailing: by its sender only, once, not dated in the future, with its fingerprint.
  submitMustFail c.alice $ exerciseCmd offer RecordMailing with sentOn = now; mailingRef = h "mail"
  submitMustFail c.issuer $ exerciseCmd offer RecordMailing with sentOn = now; mailingRef = "no"
  submitMustFail c.issuer $ exerciseCmd offer RecordMailing with sentOn = addRelTime now (days 2); mailingRef = h "mail"
  offer <- submit c.issuer $ exerciseCmd offer RecordMailing with sentOn = now; mailingRef = h "mail"
  submitMustFail c.issuer $ exerciseCmd offer RecordMailing with sentOn = now; mailingRef = h "mail2"
  -- The delivery receipt: by the assignee only, once.
  let today = toDateUTC now
  submitMustFail c.issuer $ exerciseCmd offer RecordReceipt with received = today; ref = h "rcpt"
  offer <- submit c.alice $ exerciseCmd offer RecordReceipt with received = today; ref = h "rcpt"
  submitMustFail c.alice $ exerciseCmd offer RecordReceipt with received = today; ref = h "rcpt2"
  -- Accepted, the assignment keeps all three, and a UCC-3 filed later goes on by the assignor (here the issuer) only.
  a <- submit c.alice $ exerciseCmd offer Accept
  submitMustFail c.alice $ exerciseCmd a RecordUcc3OnAssignment with filedHash = h "ucc3"
  a <- submit c.issuer $ exerciseCmd a RecordUcc3OnAssignment with filedHash = h "ucc3"
  submitMustFail c.issuer $ exerciseCmd a RecordUcc3OnAssignment with filedHash = h "ucc3b"
  Some v <- queryContractId c.alice a
  v.deliveryRef === Some (h "mail")
  v.mailedOn === Some now
  v.receiptRef === Some (h "rcpt")
  v.receivedOn === Some today
  v.ucc3Hash === Some (h "ucc3")
  pure ()

test_lock_cancel_redeem = script do
  (c, bond) <- setup
  (bond, a1) <- issueAndAccept c bond
  -- An unclaimed assign-out, cancelled by its assignor in one act: the units come straight back.
  (rest, offer) <- submit c.alice $ exerciseCmd a1 AssignOut with
    childId = "PENS-0001-BD-A00001-1"; childUnits = 1040; childHash = h "d1"; childName = "Company D"; childParty = None
  submitMustFail c.bob $ exerciseCmd rest CancelAssignOut with offerCid = offer
  rest <- submit c.alice $ exerciseCmd rest CancelAssignOut with offerCid = offer
  Some r <- queryContractId c.alice rest
  r.units === 1_000_000
  -- Once claimed, the assignor can't cancel it; the issuer can, for a dispute, and the assignor takes the units back.
  (rest, offer) <- submit c.alice $ exerciseCmd rest AssignOut with
    childId = "PENS-0001-BD-A00001-2"; childUnits = 500; childHash = h "d2"; childName = "Company D"; childParty = Some c.bob
  submitMustFail c.alice $ exerciseCmd rest CancelAssignOut with offerCid = offer
  submitMustFail c.alice $ exerciseCmd offer IssuerCancel with reason = "Disputed"
  back <- submit c.issuer $ exerciseCmd offer IssuerCancel with reason = "Disputed by the assignor's lender"
  rest <- submit c.alice $ exerciseCmd rest ReclaimToAssignment with returnedCid = back
  -- Locked by the assignee: no assign-outs, no redemption. Any lock but a claimed pledge, they lift themselves.
  submitMustFail c.issuer $ exerciseCmd rest Lock with kind = "sale"; reason = "x"; lender = None
  rest <- submit c.alice $ exerciseCmd rest Lock with kind = "sale"; reason = "Pending sale"; lender = None
  submitMustFail c.alice $ exerciseCmd rest AssignOut with
    childId = "PENS-0001-BD-A00001-3"; childUnits = 1; childHash = h "d3"; childName = "X"; childParty = None
  submitMustFail c.issuer $ exerciseCmd rest Redeem with paymentHash = h "paid"; bondCid = bond
  submitMustFail c.issuer $ exerciseCmd rest Unlock
  rest <- submit c.alice $ exerciseCmd rest Unlock
  -- A pledge names its lender. Before the lender claims it, the assignee can withdraw it.
  submitMustFail c.alice $ exerciseCmd rest Lock with kind = "pledge"; reason = "Pledged"; lender = None
  rest <- submit c.alice $ exerciseCmd rest Lock with kind = "pledge"; reason = "Pledged"; lender = Some "First Bank"
  rest <- submit c.alice $ exerciseCmd rest Unlock
  -- Once the lender has claimed it, only the lender releases it: not the assignee, not the issuer.
  rest <- submit c.alice $ exerciseCmd rest Lock with kind = "pledge"; reason = "Pledged"; lender = Some "First Bank"
  submitMustFail c.alice $ exerciseCmd rest BindPledgee with party = c.trustee
  rest <- submit c.platform $ exerciseCmd rest BindPledgee with party = c.trustee
  submitMustFail c.platform $ exerciseCmd rest BindPledgee with party = c.outsider
  submitMustFail c.alice $ exerciseCmd rest Unlock
  submitMustFail c.issuer $ exerciseCmd rest ReleasePledge with lender = c.issuer
  submitMustFail c.outsider $ exerciseCmd rest ReleasePledge with lender = c.outsider
  rest <- submit c.trustee $ exerciseCmd rest ReleasePledge with lender = c.trustee
  Some r <- queryContractId c.alice rest
  (r.locked, r.pledgeTo, r.pledgee) === (None, None, None)
  submit c.issuer $ exerciseCmd rest Redeem with paymentHash = h "paid"; bondCid = bond
  [(_, b)] <- query @Bond c.issuer
  b.redeemed === 1_000_000
  pure ()

test_prior_and_replacement = script do
  (c, bond) <- setup
  -- A prior instrument comes off what's left to assign; only the issuer records or reverses it.
  submitMustFail c.alice $ exerciseCmd bond RecordPrior with entryId = "P001"; identifierHash = h "pn7"; units = 5_000; holderName = "Old Note Holder LLC"
  submitMustFail c.issuer $ exerciseCmd bond RecordPrior with entryId = "P001"; identifierHash = h "pn7"; units = 10_000_000_001; holderName = "X"
  (bond, p1) <- submit c.issuer $ exerciseCmd bond RecordPrior with entryId = "P001"; identifierHash = h "pn7"; units = 5_000; holderName = "Old Note Holder LLC"
  Some pv <- queryContractId c.issuer p1
  pv.holderName === "Old Note Holder LLC"   -- who holds it is on the contract
  Some b <- queryContractId c.issuer bond
  (b.unassigned, b.prior) === (10_000_000_000 - 5_000, 5_000)
  length <$> query @PriorInstrument c.trustee >>= (=== 1)   -- the bond's trustee sees it
  length <$> query @PriorInstrument c.outsider >>= (=== 0)
  submitMustFail c.issuer $ exerciseCmd bond ReversePrior with priorCid = p1; reasonHash = "no"
  bond <- submit c.issuer $ exerciseCmd bond ReversePrior with priorCid = p1; reasonHash = h "error"
  Some b <- queryContractId c.issuer bond
  (b.unassigned, b.prior) === (10_000_000_000, 0)
  length <$> query @PriorReversed c.issuer >>= (=== 1)
  -- An offer replaced by the issuer: a new offer, same amount, new paper; the old one's replacement kept.
  (bond, offer) <- submit c.issuer $ exerciseCmd bond Issue with
    recordId = "PENS-0001-BD-A00001"; units = 1_000; docHash = h "a1"; ucc3Hash = None; assigneeName = "Company A"; assignee = Some c.alice
  submitMustFail c.alice $ exerciseCmd offer SupersedeOffer with newRecordId = "PENS-0001-BD-A00002"; newHash = h "a2"; newAssigneeName = "Company A Holdings"; reasonHash = h "why"
  o2 <- submit c.issuer $ exerciseCmd offer SupersedeOffer with newRecordId = "PENS-0001-BD-A00002"; newHash = h "a2"; newAssigneeName = "Company A Holdings"; reasonHash = h "why"
  Some v <- queryContractId c.issuer o2
  (v.recordId, v.units, v.instrumentHash, v.parentId) === ("PENS-0001-BD-A00002", 1_000, h "a2", Some "PENS-0001-BD-A00001")
  (v.issuerName, v.assignorName) === ("Penson Trust", "Penson Trust")
  -- An accepted assignment: the issuer can only propose replacing it; its assignee consents or declines.
  o2 <- submit c.platform $ exerciseCmd o2 Bind with party = c.bob
  a2 <- submit c.bob $ exerciseCmd o2 Accept
  submitMustFail c.issuer $ exerciseCmd a2 ReplaceByConsent with newRecordId = "PENS-0001-BD-A00003"; newHash = h "a3"; newAssigneeName = "D"; reasonHash = h "w"
  submitMustFail c.bob $ exerciseCmd a2 ReplaceByConsent with newRecordId = "PENS-0001-BD-A00003"; newHash = h "a3"; newAssigneeName = "D"; reasonHash = h "w"
  let proposal = ReplacementProposal with
        issuer = c.issuer; platform = c.platform; assignee = c.bob; bondId = "PENS-0001-BD"
        recordId = "PENS-0001-BD-A00002"; newRecordId = "PENS-0001-BD-A00003"; newHash = h "a3"; newAssigneeName = "D"; reasonHash = h "w"
  p1 <- submit c.issuer $ createCmd proposal
  submit c.bob $ exerciseCmd p1 Decline
  length <$> query @Assignment c.bob >>= (=== 1)              -- declined: nothing changed
  p2 <- submit c.issuer $ createCmd proposal
  submitMustFail c.alice $ exerciseCmd p2 Consent with assignmentCid = a2
  -- Not while it's locked.
  a2 <- submit c.bob $ exerciseCmd a2 Lock with kind = "sale"; reason = "x"; lender = None
  submitMustFail c.bob $ exerciseCmd p2 Consent with assignmentCid = a2
  a2 <- submit c.bob $ exerciseCmd a2 Unlock
  o3 <- submit c.bob $ exerciseCmd p2 Consent with assignmentCid = a2
  Some v <- queryContractId c.issuer o3
  (v.recordId, v.units, v.instrumentHash) === ("PENS-0001-BD-A00003", 1_000, h "a3")
  length <$> query @Superseded c.issuer >>= (=== 2)
  length <$> query @Assignment c.bob >>= (=== 0)
  pure ()
