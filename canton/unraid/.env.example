# Copy to .env and fill in. Generate each secret with:  openssl rand -base64 24
# Never commit .env.

# Where the database lives on the array (back this folder up).
APPDATA=/mnt/user/appdata/canton-node

POSTGRES_PASSWORD=

# One key per app; the same value goes in that app's CANTON_API_KEY on Railway.
KEY_BOND_REGISTRY=
KEY_OMNI_STANCE=

# The dashboard's sign-in. Leave empty to switch the dashboard off.
DASHBOARD_PASSWORD=

# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Install connector (the token after --token).
# Point the tunnel's public hostname (e.g. canton.yourdomain.com) at http://gateway:8080.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional
# GATEWAY_LAN_PORT=8686
# CANTON_MEMORY=3g
# CANTON_JAVA_OPTS=-Xms512m -Xmx1300m
# SOURCE=https://github.com/KingMelo/bond-registry.git#claude/laughing-babbage-0zuuuw
